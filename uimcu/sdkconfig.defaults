# Panel controller (ESP32-C3 Super Mini) — doc/ui-split-sdd.md §5.1
# 4MB flash, single app slot + storage (partitions.csv).

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Console = USB-Serial-JTAG ONLY. UART0 (GPIO20/21) is reserved for the
# panel<->DSP link (SDD §2.1), so the default console must not claim it.
# The bench/debug STX/ETX channel (DebugLink) also lives on the USB console.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_FREERTOS_HZ=100
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# BT coex calibration lessons do not apply here, but keep the interrupt
# watchdog generous like sdkconfig.defaults.a1s so a slow bring-up path
# (RapidJSON parse of a large stub blob) cannot trip it.
CONFIG_ESP_INT_WDT_TIMEOUT_MS=5000

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_NVS_PERSIST=y

