# BBA v2 — custom ESP32-S3-WROOM-1 (N16R8: 16 MB flash, 8 MB Octal PSRAM),
# WM8978 codec, no card-detect, C3 panel link on UART1 (doc/bba2-esp32s3-sdd.md §4).
# Applied as: -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.bba2"
# (later files win for conflicting keys; this file must come last).

CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y

# 240 MHz CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# 16 MB flash QIO 80M (partition table from the common defaults:
# dual 3.5 MB OTA + 3 MB storage + sample ROM at 0xB00000)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# 8 MB Octal PSRAM @ 80 MHz (bench configuration)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
# malloc prefers internal SRAM for allocations up to 128 KB (Kconfig max):
# plugin DSP objects (Elements' ~116 KB Part among them) MUST render from
# internal SRAM — from PSRAM the render cost roughly doubles (246k vs 117k
# cycles) and overruns the 44.1 kHz audio budget. The S3 has 512 KB SRAM;
# PSRAM stays available as the fallback when internal is exhausted.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=131072

# Native USB console (GPIO19/20), log capture = USB Serial/JTAG port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# INFO default: DEBUG-level per-parameter logging floods the USJ TX FIFO
# (50 ms busy-wait per line when the host is not draining it) and freezes
# the link task on every knob turn (handoff doc, Finding 1).
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 100 Hz tick (matched to A1S and all other TBD targets)
CONFIG_FREERTOS_HZ=100

# Tickless idle OFF: its suppress path delayed queue wakes by ~3-5 ms on the
# audio core (the I2S msg-queue lost-wakeup signature, bench-proved
# 2026-11-06); the audio task blocks ~0.7 ms per block so tickless saves
# nothing anyway.
CONFIG_FREERTOS_USE_TICKLESS_IDLE=n

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# SD long filenames on the SDMMC FAT mount (same as a1s full config)
CONFIG_FATFS_LFN_HEAP=y

# Arena size on BBA2: STEREO blockMem 107,392 B covers Freakwaves (105,984 B
# need — the 106,496 clamp starved it by 3,712 B and asserted at load), CH
# slices 55,488 B, and ~120 KB contiguous SRAM1 remains for the Elements
# object (115,844 B). Kconfig range 104448..118784.
CONFIG_SP_FIXED_MEM_ALLOC_SZ=112128

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_INT_WDT_TIMEOUT_MS=5000
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# Select the platform (so a plain `idf.py build` with this defaults file
# needs no menuconfig)
CONFIG_TBD_PLATFORM_BBA2=y

# stmlib's IN_RAM macro puts tides2 render fns into a `.ramtext` section the
# IDF 6.x S3 linker fragments don't place. The proven esp32 builds auto-placed
# it into flash text anyway (map: .ramtext @ 0x402af4b8) — replicate that.
CONFIG_COMPILER_ORPHAN_SECTIONS_PLACE=y

# 32 KB I-cache (default 16 KB): on the S3 the L1 caches are SHARED between
# both cores, and the render code footprint (Elements/Subbotnik hot paths)
# exceeds 16 KB — core-0 traffic evicted the render's hot lines and measured
# +60-100k cycles/block on Subbotnik (236k vs 174k budget). The extra 16 KB
# comes out of the reclaimed-IRAM pool (0x40374000).
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
